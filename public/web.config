<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Rule 1: Don't rewrite API calls -->
        <rule name="API Requests" stopProcessing="true">
          <match url="^TestBank/MISPortal_Dev/(.*)" />
          <action type="None" />
        </rule>
        
        <!-- Rule 2: Don't rewrite static files -->
        <rule name="Static Files" stopProcessing="true">
          <match url="^TestBank/MISPortal_Build/(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="false" />
          </conditions>
          <action type="None" />
        </rule>
        
        <!-- Rule 3: Rewrite all other requests to index.html -->
        <rule name="React Router" stopProcessing="true">
          <match url="^TestBank/MISPortal_Build/(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/TestBank/MISPortal_Build/index.html" />
        </rule>
      </rules>
    </rewrite>
    
    <!-- For SPA handling -->
    <httpErrors errorMode="Custom">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/TestBank/MISPortal_Build/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>